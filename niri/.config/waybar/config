{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 5,

    "modules-left": [
        "niri/workspaces",
        // "custom/project",
        "custom/media",
        "custom/media-prev",
        "custom/media-play",
        "custom/media-next"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "battery",
        "pulseaudio",
        "bluetooth",
        "backlight",
        "network",
        "cpu",
        "memory",
        "custom/hourglass"
    ],

    // ─────────────────────────────────────
    // NIRI WORKSPACES
    // ─────────────────────────────────────

    "niri/workspaces": {
        "format": "{index}",
        "on-click": "activate",
        "sort-by-id": true,
        "all-outputs": false
    },

    // ─────────────────────────────────────
    // PROJECT BUTTON
    // ─────────────────────────────────────

    // "custom/project": {
        // "format": "project",
        // "max-length": 13,
        // "on-click": "/home/iko/.config/dotfiles/niri/.config/scripts/toggle-side-waybar.sh",
        // "tooltip": false
    // },

    // ─────────────────────────────────────
    // CLOCK
    // ─────────────────────────────────────

    "clock": {
        "format": "{:%H:%M}",
        "on-click": "eww open --toggle clock-popup"
        // "format-alt": "{:%A, %d %B %Y}",
    },

    // ─────────────────────────────────────
    // BATTERY
    // ─────────────────────────────────────

    "battery": {
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰂄 {capacity}%",
        "format-icons": [
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ],
        "states": {
            "warning": 30,
            "critical": 15
        },
        "tooltip-format": "{timeTo} remaining"
    },

    // ─────────────────────────────────────
    // BRIGHTNESS
    // ─────────────────────────────────────

    "backlight": {
        "device": "intel_backlight",
        "format": "{icon} {percent}%",
        "format-icons": [
            "󰃞",
            "󰃟",
            "󰃠"
        ],
        "scroll-step": 5,
        "tooltip-format": "Brightness: {percent}%"
    },

    // ─────────────────────────────────────
    // NETWORK / WIFI
    // ─────────────────────────────────────

     "network": {
       "format": "{ifname}",
       "format-wifi": "  {essid}",
       "format-ethernet": "󰈀  {ifname}",
       "format-disconnected": "Disconnected",
       "tooltip-format-wifi": "  {ifname} @ {essid}\nIP: {ipaddr}\nStrength: {signalStrength}%\nFreq: {frequency}MHz\nUp: {bandwidthUpBits} Down: {bandwidthDownBits}",
       "tooltip-format-ethernet": "󰈀  {ifname}\nIP: {ipaddr}\n up: {bandwidthUpBits} down: {bandwidthDownBits}",
       "tooltip-format-disconnected": "Disconnected",
       "max-length": 50,
       "on-click": "alacritty --title nmtui --config-file /home/iko/.config/dotfiles/niri/.config/alacritty/float.toml -e nmtui connect",
     },
    // ─────────────────────────────────────
    // CPU
    // ─────────────────────────────────────

    "cpu": {
        "interval": 2,
        "format": "󰍛 {usage}%",
        "states": {
            "warning": 70,
            "critical": 90
        },
        "tooltip": true,
        "on-click": ""
    },

    // ─────────────────────────────────────
    // MEMORY
    // ─────────────────────────────────────

    "memory": {
        "interval": 2,
        "format": "󰘚 {percentage}%",
        "states": {
            "warning": 70,
            "critical": 90
        },
        "tooltip-format": "RAM: {used:0.1f} GiB / {total:0.1f} GiB"
    },

    // ─────────────────────────────────────
    // HOURGLASS
    // ─────────────────────────────────────

    "custom/hourglass": {
        "format": "󰔛",
        "escape": true,
        "return_type": "json",
        "exec": "~/.config/waybar/modules/check-swayidle.sh",
        "on-click": "~/.config/scripts/change-idle-time.sh",
        "restart-interval": 1
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰖁 Muted",

        "format-icons": {
            "headphone": "󰋋",
            "hands-free": "󰋎",
            "headset": "󰋎",
            "phone": "󰏲",
            "portable": "󰦧",
            "car": "󰄋",

            "default": [
                "󰕿",
                "󰖀",
                "󰕾"
            ]
        },

        "scroll-step": 5,

        "on-click": "pavucontrol",
        "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",

        "tooltip-format": "Volume: {volume}%"
    },

    "bluetooth": {
        "format": "󰂯 {status}",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "format-on": "󰂯",
        "format-connected": "󰂯 {num_connections}",
        "format-connected-battery": "󰂯 {device_battery_percentage}%",

        "tooltip-format": "{controller_alias}\n{num_connections} connected",
        "tooltip-format-connected": "{controller_alias}\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\n{device_address}",

        "on-click": "~/.config/waybar/scripts/bluetooth.sh",
        "on-click-right": "bluetoothctl power off"
    },

    // custom medial player

    "custom/media": {
        "format": "{}",
        "tooltip": true,
        "escape": true,
        "return-type": "json",
        "max-length": 20,

        "restart-interval": 1,

        "exec": "/home/iko/.config/waybar/modules/media-player.sh",

        // "on-click": "/home/iko/.config/waybar/modules/media-control.sh play-pause",

        "on-click": "eww open --toggle media-player-selector"

        // "on-scroll-up": "/home/iko/.config/waybar/modules/media-control.sh previous",

        // "on-scroll-down": "/home/iko/.config/waybar/modules/media-control.sh next"
    },

    "custom/media-prev": {
        "format": "⏮",
        "tooltip": true,
        "tooltip-format": "Previous",
        "exec": "echo prev",
        "on-click": "/home/iko/.config/waybar/modules/media-control.sh previous"
    },

    "custom/media-play": {
        "format": "⏯",
        "tooltip": true,
        "tooltip-format": "Play/Pause",
        "exec": "echo play",
        "on-click": "/home/iko/.config/waybar/modules/media-control.sh play-pause"
    },

    "custom/media-next": {
        "format": "⏭",
        "tooltip": true,
        "tooltip-format": "Next",
        "exec": "echo next",
        "on-click": "/home/iko/.config/waybar/modules/media-control.sh next"
    }
}
