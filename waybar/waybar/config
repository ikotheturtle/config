{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 5,

    "modules-left": [
        "niri/workspaces",
        "niri/window",
        "custom/media"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "battery",
        "pulseaudio",
        "bluetooth",
        "backlight",
        "network",
        "cpu",
        "memory",
        "custom/hourglass"
    ],

    // ─────────────────────────────────────
    // NIRI WORKSPACES
    // ─────────────────────────────────────

    "niri/workspaces": {
        "format": "{index}",
        "on-click": "activate",
        "sort-by-id": true,
        "all-outputs": false
    },

    // ─────────────────────────────────────
    // ACTIVE WINDOW
    // ─────────────────────────────────────

    "niri/window": {
        "format": "{title}",
        "max-length": 15,
        "separate-outputs": true
    },

    // ─────────────────────────────────────
    // CLOCK
    // ─────────────────────────────────────

    "clock": {
        "format": "{:%H:%M}",
        "on-click": "eww open --toggle clock-popup"
        // "format-alt": "{:%A, %d %B %Y}",
    },

    // ─────────────────────────────────────
    // BATTERY
    // ─────────────────────────────────────

    "battery": {
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰂄 {capacity}%",
        "format-icons": [
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ],
        "states": {
            "warning": 30,
            "critical": 15
        },
        "tooltip-format": "{timeTo} remaining"
    },

    // ─────────────────────────────────────
    // BRIGHTNESS
    // ─────────────────────────────────────

    "backlight": {
        "device": "intel_backlight",
        "format": "{icon} {percent}%",
        "format-icons": [
            "󰃞",
            "󰃟",
            "󰃠"
        ],
        "scroll-step": 5,
        "tooltip-format": "Brightness: {percent}%"
    },

    // ─────────────────────────────────────
    // NETWORK / WIFI
    // ─────────────────────────────────────

    "network": {
        "format-wifi": "󰤨 {essid}",
        "format-ethernet": "󰈀 {ipaddr}",
        "format-disconnected": "󰤭 Offline",

        "format-icons": [
            "󰤯",
            "󰤟",
            "󰤢",
            "󰤥",
            "󰤨"
        ],

        "tooltip-format-wifi": "SSID: {essid}\nSignal: {signalStrength}%\nIP: {ipaddr}",
        "tooltip-format-ethernet": "Interface: {ifname}\nIP: {ipaddr}",
        "tooltip-format-disconnected": "Disconnected",

        "on-click": "~/.config/waybar/scripts/wifi.sh"
    },

    // ─────────────────────────────────────
    // CPU
    // ─────────────────────────────────────

    "cpu": {
        "interval": 2,
        "format": "󰍛 {usage}%",
        "states": {
            "warning": 70,
            "critical": 90
        },
        "tooltip": true,
        "on-click": ""
    },

    // ─────────────────────────────────────
    // MEMORY
    // ─────────────────────────────────────

    "memory": {
        "interval": 2,
        "format": "󰘚 {percentage}%",
        "states": {
            "warning": 70,
            "critical": 90
        },
        "tooltip-format": "RAM: {used:0.1f} GiB / {total:0.1f} GiB"
    },

    // ─────────────────────────────────────
    // HOURGLASS
    // ─────────────────────────────────────

    "custom/hourglass": {
        "format": "󰔛",
        "escape": true,
        "return_type": "json",
        "exec": "~/.config/waybar/modules/check-swayidle.sh",
        "on-click": "~/.config/scripts/change-idle-time.sh",
        "restart-interval": 1
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰖁 Muted",

        "format-icons": {
            "headphone": "󰋋",
            "hands-free": "󰋎",
            "headset": "󰋎",
            "phone": "󰏲",
            "portable": "󰦧",
            "car": "󰄋",

            "default": [
                "󰕿",
                "󰖀",
                "󰕾"
            ]
        },

        "scroll-step": 5,

        "on-click": "pavucontrol",
        "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",

        "tooltip-format": "Volume: {volume}%"
    },

    "bluetooth": {
        "format": "󰂯 {status}",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "format-on": "󰂯",
        "format-connected": "󰂯 {num_connections}",
        "format-connected-battery": "󰂯 {device_battery_percentage}%",

        "tooltip-format": "{controller_alias}\n{num_connections} connected",
        "tooltip-format-connected": "{controller_alias}\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\n{device_address}",

        "on-click": "~/.config/waybar/scripts/bluetooth.sh",
        "on-click-right": "bluetoothctl power off"
    },

    // custom medial player

    "custom/media": {
       "format": "{}",
       "tooltip": true,
       "tooltip-format": "{}",
       "escape": true,
       "return-type": "json",
       "max-length": 35,


       "restart-interval": 1,
       "on-click": "playerctl --player=\"$(cat \"$XDG_RUNTIME_DIR/waybar-media-player\")\" play-pause",
       "on-click-right": "eww open --toggle media-player-selector",
       "exec": "~/.config/waybar/modules/media-player.sh",

       // "on-click": "playerctl play-pause",
       // "on-click-right": "playerctl stop",

       "on-scroll-up": "playerctl --player=\"$(cat \"$XDG_RUNTIME_DIR/waybar-media-player\")\" previous",
       "on-scroll-down": "playerctl --player=\"$(cat \"$XDG_RUNTIME_DIR/waybar-media-player\")\" next"

       // "exec": "~/.config/waybar/modules/media-player.py 2>/dev/null"
    }
}
